# Copy to .env for local development, and add the same names in Vercel > Settings > Environment Variables.

# Storage (Supabase > Project Settings > API). Without these, local dev uses .data/store.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: Stripe TEST secret key (starts with sk_test_). Stripe > Developers > API keys.
STRIPE_SECRET_KEY=

# AI organizer: Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
